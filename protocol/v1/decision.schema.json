{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema-guard.dev/protocol/v1/decision.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "decision",
    "repaired_fields",
    "policy_result",
    "audit_id",
    "audit"
  ],
  "properties": {
    "protocol_version": { "const": "2026-07-18" },
    "decision": { "enum": ["valid", "valid_with_repair", "rejected"] },
    "valid_arguments": { "type": "object" },
    "repaired_fields": { "type": "array", "items": { "$ref": "#/$defs/repair" } },
    "reason_code": { "$ref": "#/$defs/reasonCode" },
    "reason": { "type": "string", "minLength": 1 },
    "repair_hint": { "type": "string" },
    "validation_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "keyword", "message"],
        "properties": {
          "path": { "type": "string" },
          "keyword": { "type": "string" },
          "message": { "type": "string" },
          "expected": { "type": "string" }
        }
      }
    },
    "policy_result": { "$ref": "#/$defs/policyResult" },
    "audit_id": { "type": "string", "pattern": "^aud_[0-9a-f-]{36}$" },
    "audit": { "$ref": "#/$defs/audit" }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "rejected" } }, "required": ["decision"] },
      "then": {
        "properties": { "reason_code": {}, "reason": {}, "repair_hint": {} },
        "required": ["reason_code", "reason", "repair_hint"],
        "not": { "properties": { "valid_arguments": {} }, "required": ["valid_arguments"] }
      },
      "else": {
        "properties": { "valid_arguments": {} },
        "required": ["valid_arguments"],
        "not": {
          "anyOf": [
            { "properties": { "reason_code": {} }, "required": ["reason_code"] },
            { "properties": { "reason": {} }, "required": ["reason"] }
          ]
        }
      }
    }
  ],
  "$defs": {
    "reasonCode": {
      "enum": [
        "ARGUMENTS_NOT_OBJECT",
        "ARGUMENTS_JSON_INVALID",
        "SCHEMA_INVALID",
        "SCHEMA_VALIDATION_FAILED",
        "RESOURCE_LIMIT_EXCEEDED",
        "REPAIR_LIMIT_EXCEEDED",
        "POLICY_DENIED",
        "INTERNAL_ERROR"
      ]
    },
    "repairRule": {
      "enum": [
        "coerce.string_to_number",
        "coerce.string_to_integer",
        "coerce.string_to_boolean",
        "coerce.singleton_to_array"
      ]
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "rule_id", "from_type", "to_type", "original_value_hash", "explanation"],
      "properties": {
        "path": { "type": "string" },
        "rule_id": { "$ref": "#/$defs/repairRule" },
        "from_type": { "type": "string" },
        "to_type": { "type": "string" },
        "original_value_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "explanation": { "type": "string", "minLength": 1 }
      }
    },
    "policyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "applied_policy_hash", "reasons"],
      "properties": {
        "outcome": { "enum": ["allowed", "denied"] },
        "applied_policy_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_id",
        "timestamp",
        "protocol_version",
        "engine_version",
        "ruleset_version",
        "tool_name_hash",
        "schema_hash",
        "arguments_hash",
        "argument_shape",
        "decision",
        "repair_rule_ids",
        "policy_hash"
      ],
      "properties": {
        "audit_id": { "type": "string", "pattern": "^aud_[0-9a-f-]{36}$" },
        "timestamp": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
        "protocol_version": { "const": "2026-07-18" },
        "engine_version": { "type": "string" },
        "ruleset_version": { "type": "string" },
        "tool_name_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "schema_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "arguments_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "argument_shape": { "type": "array", "items": { "type": "string" } },
        "decision": { "enum": ["valid", "valid_with_repair", "rejected"] },
        "reason_code": { "$ref": "#/$defs/reasonCode" },
        "repair_rule_ids": { "type": "array", "items": { "$ref": "#/$defs/repairRule" } },
        "policy_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    }
  }
}
