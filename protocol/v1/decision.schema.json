{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema-guard.dev/protocol/v1/decision.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "decision",
    "repaired_fields",
    "policy_result",
    "audit_id",
    "audit"
  ],
  "properties": {
    "protocol_version": { "const": "2026-07-20" },
    "decision": { "enum": ["valid", "valid_with_repair", "rejected"] },
    "valid_arguments": { "type": "object" },
    "repaired_fields": { "type": "array", "items": { "$ref": "#/$defs/repair" } },
    "reason_code": { "$ref": "#/$defs/reasonCode" },
    "reason": { "type": "string", "minLength": 1 },
    "repair_hint": { "type": "string" },
    "validation_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "keyword", "message"],
        "properties": {
          "path": { "type": "string" },
          "keyword": { "type": "string" },
          "message": { "type": "string" },
          "expected": { "type": "string" }
        }
      }
    },
    "policy_result": { "$ref": "#/$defs/policyResult" },
    "audit_id": { "type": "string", "pattern": "^aud_[0-9a-f-]{36}$" },
    "audit": { "$ref": "#/$defs/audit" }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "rejected" } }, "required": ["decision"] },
      "then": {
        "properties": { "reason_code": {}, "reason": {}, "repair_hint": {} },
        "required": ["reason_code", "reason", "repair_hint"],
        "allOf": [
          { "not": { "properties": { "valid_arguments": {} }, "required": ["valid_arguments"] } },
          {
            "not": {
              "properties": {
                "audit": {
                  "type": "object",
                  "properties": {
                    "validated_arguments_hash": { "$ref": "#/$defs/hash" }
                  },
                  "required": ["validated_arguments_hash"]
                }
              },
              "required": ["audit"]
            }
          }
        ]
      },
      "else": {
        "properties": {
          "valid_arguments": {},
          "audit": {
            "type": "object",
            "properties": {
              "validated_arguments_hash": { "$ref": "#/$defs/hash" }
            },
            "required": ["validated_arguments_hash"]
          }
        },
        "required": ["valid_arguments"],
        "not": {
          "anyOf": [
            { "properties": { "reason_code": {} }, "required": ["reason_code"] },
            { "properties": { "reason": {} }, "required": ["reason"] }
          ]
        }
      }
    }
  ],
  "$defs": {
    "reasonCode": {
      "enum": [
        "ARGUMENTS_NOT_OBJECT",
        "ARGUMENTS_JSON_INVALID",
        "SCHEMA_INVALID",
        "SCHEMA_VALIDATION_FAILED",
        "RESOURCE_LIMIT_EXCEEDED",
        "REPAIR_LIMIT_EXCEEDED",
        "POLICY_DENIED",
        "INTERNAL_ERROR"
      ]
    },
    "repairRule": {
      "enum": [
        "coerce.string_to_number",
        "coerce.string_to_integer",
        "coerce.string_to_boolean",
        "coerce.singleton_to_array"
      ]
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "rule_id",
        "ruleset_version",
        "from_type",
        "to_type",
        "original_value_hash",
        "output_value_hash",
        "schema_fragment_hash",
        "matched_preconditions",
        "ambiguity_checks",
        "post_validation",
        "receipt_hash",
        "explanation"
      ],
      "properties": {
        "path": { "type": "string" },
        "rule_id": { "$ref": "#/$defs/repairRule" },
        "ruleset_version": { "const": "oss-2026-07-18.1" },
        "from_type": { "type": "string" },
        "to_type": { "type": "string" },
        "original_value_hash": { "$ref": "#/$defs/hash" },
        "output_value_hash": { "$ref": "#/$defs/hash" },
        "schema_fragment_hash": { "$ref": "#/$defs/hash" },
        "matched_preconditions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "ambiguity_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check", "result"],
            "properties": {
              "check": { "type": "string", "minLength": 1 },
              "result": { "const": "passed" }
            }
          }
        },
        "post_validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "policy"],
          "properties": {
            "schema": { "enum": ["passed", "failed", "not_run"] },
            "policy": { "enum": ["allowed", "denied", "not_run"] }
          }
        },
        "receipt_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "explanation": { "type": "string", "minLength": 1 }
      }
    },
    "hash": {
      "type": "string",
      "pattern": "^(?:sha256|hmac-sha256):[0-9a-f]{64}$"
    },
    "policyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "applied_policy_hash", "reasons"],
      "properties": {
        "outcome": { "enum": ["allowed", "denied"] },
        "applied_policy_hash": { "$ref": "#/$defs/hash" },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_id",
        "timestamp",
        "protocol_version",
        "engine_version",
        "ruleset_version",
        "tool_name_hash",
        "schema_hash",
        "arguments_hash",
        "argument_shape",
        "decision",
        "repair_rule_ids",
        "repair_receipt_hashes",
        "policy_hash"
      ],
      "properties": {
        "audit_id": { "type": "string", "pattern": "^aud_[0-9a-f-]{36}$" },
        "timestamp": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
        "protocol_version": { "const": "2026-07-20" },
        "engine_version": { "type": "string" },
        "ruleset_version": { "type": "string" },
        "tool_name_hash": { "$ref": "#/$defs/hash" },
        "schema_hash": { "$ref": "#/$defs/hash" },
        "arguments_hash": { "$ref": "#/$defs/hash" },
        "validated_arguments_hash": { "$ref": "#/$defs/hash" },
        "argument_shape": { "type": "array", "items": { "type": "string" } },
        "decision": { "enum": ["valid", "valid_with_repair", "rejected"] },
        "reason_code": { "$ref": "#/$defs/reasonCode" },
        "repair_rule_ids": { "type": "array", "items": { "$ref": "#/$defs/repairRule" } },
        "repair_receipt_hashes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "policy_hash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
