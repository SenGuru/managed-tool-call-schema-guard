{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema-guard.dev/protocol/v1/validate-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["tool_name", "tool_schema", "raw_arguments"],
  "properties": {
    "protocol_version": { "const": "2026-07-20" },
    "tool_name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "tool_schema": { "anyOf": [{ "type": "object" }, { "type": "boolean" }] },
    "raw_arguments": { "anyOf": [{ "type": "object" }, { "type": "string" }] },
    "policy": { "$ref": "#/$defs/policy" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapter": { "enum": ["json_schema", "mcp", "openai_agents", "pydantic_ai", "google_adk"] },
        "tool_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "schema_revision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
        "provider_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "framework": { "type": "string", "minLength": 1, "maxLength": 128 },
        "framework_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "environment": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_repairs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "coerce.string_to_number",
              "coerce.string_to_integer",
              "coerce.string_to_boolean",
              "coerce.singleton_to_array"
            ]
          }
        },
        "max_repairs": { "type": "integer", "minimum": 0, "maximum": 100 },
        "deny_argument_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/", "maxLength": 1024 }
        },
        "require_closed_schema": { "type": "boolean" }
      }
    }
  }
}
