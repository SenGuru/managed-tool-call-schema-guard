{
  "name": "schema-guard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "check": "npm run format:check && npm run lint && npm run check:scripts && npm run check:packages && npm run typecheck && npm test && npm run test:python",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prelint": "npm run build",
    "lint": "eslint .",
    "check:scripts": "node --check examples/agent-loop/mcp-guard-server.mjs && node --check examples/agent-loop/run-live.mjs && node --check examples/agent-loop/verify-results.mjs",
    "check:packages": "tsx scripts/check-packages.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:python": "npm run build && PYTHONPATH=python python3 -m unittest discover -s python/tests",
    "benchmark": "npm run build --silent && tsx benchmarks/core.ts",
    "demo": "npm run build --silent && tsx examples/demo.ts",
    "schemaguard": "npm run build --silent && tsx packages/cli/src/cli.ts",
    "api": "npm run build --silent && tsx packages/api/src/server.ts",
    "managed": "npm run build --silent && tsx packages/managed/src/server.ts",
    "managed:bootstrap": "npm run build --silent && tsx packages/managed/src/bootstrap.ts",
    "agent-test:live": "npm run build --silent && node examples/agent-loop/run-live.mjs",
    "agent-test:verify": "node examples/agent-loop/verify-results.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "ajv": "^8.20.0",
    "eslint": "^10.7.0",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  }
}
