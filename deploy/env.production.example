SCHEMA_GUARD_EXTERNAL_URL=https://api.akriven.com
SCHEMA_GUARD_APP_HOST=api.akriven.com
SCHEMA_GUARD_MANAGED_IMAGE=schema-guard-managed:exact-reviewed-revision
SCHEMA_GUARD_ACME_EMAIL=operations@example.com
SCHEMA_GUARD_INSTANCE_COUNT=1
SCHEMA_GUARD_ACCESS_LOG=true
SCHEMA_GUARD_SHARED_ACTION_DATABASE_URL_FILE=/absolute/path/to/action-database-url
SCHEMA_GUARD_SHARED_CONTROL_DATABASE_URL_FILE=/absolute/path/to/control-database-url
SCHEMA_GUARD_MASTER_SECRET_FILE=/absolute/path/to/master-secret
SCHEMA_GUARD_METRICS_BEARER_TOKEN_FILE=/absolute/path/to/metrics-bearer-token
SCHEMA_GUARD_POSTGRES_PASSWORD_FILE=/absolute/path/to/postgres-password
SCHEMA_GUARD_POSTGRES_TLS_DIRECTORY=/absolute/path/to/postgres-tls
SCHEMA_GUARD_CA_BUNDLE_FILE=/absolute/path/to/postgres-tls/ca.crt
SCHEMA_GUARD_ACTION_CHECKPOINT_ANCHOR_URL=https://anchor.akriven.com/v1/checkpoints
SCHEMA_GUARD_ACTION_CHECKPOINT_ANCHOR_SIGNING_SECRET_FILE=/absolute/path/to/anchor-signing-secret
SCHEMA_GUARD_ACTION_CHECKPOINT_ANCHOR_POLL_INTERVAL_MS=5000
SCHEMA_GUARD_ACTION_CHECKPOINT_ANCHOR_REQUEST_TIMEOUT_MS=3000
SCHEMA_GUARD_ACTION_CHECKPOINT_ANCHOR_MAX_ATTEMPTS=8
SCHEMA_GUARD_ALERT_WEBHOOK_POLL_INTERVAL_MS=5000
SCHEMA_GUARD_ALERT_WEBHOOK_REQUEST_TIMEOUT_MS=5000
SCHEMA_GUARD_ALERT_WEBHOOK_MAX_ATTEMPTS=8
