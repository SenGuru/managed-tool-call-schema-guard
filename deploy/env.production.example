SCHEMA_GUARD_EXTERNAL_URL=https://app.invokeguard.example
SCHEMA_GUARD_INSTANCE_COUNT=1
# Optional partial shared-action profile; the overall managed service remains single-instance.
# SCHEMA_GUARD_SHARED_ACTION_DATABASE_URL=postgresql://least_privilege_user:password@host/schema_guard?sslmode=verify-full
# SCHEMA_GUARD_SHARED_CONTROL_DATABASE_URL=postgresql://least_privilege_user:password@host/schema_guard?sslmode=verify-full
SCHEMA_GUARD_MASTER_SECRET=replace-with-at-least-64-random-characters-from-a-secret-manager
SCHEMA_GUARD_ACTION_CHECKPOINT_ANCHOR_URL=https://independent-anchor.example.com/v1/checkpoints
SCHEMA_GUARD_ACTION_CHECKPOINT_ANCHOR_SIGNING_SECRET=replace-with-at-least-32-random-characters-from-a-secret-manager
SCHEMA_GUARD_ACTION_CHECKPOINT_ANCHOR_POLL_INTERVAL_MS=5000
SCHEMA_GUARD_ACTION_CHECKPOINT_ANCHOR_REQUEST_TIMEOUT_MS=5000
SCHEMA_GUARD_ACTION_CHECKPOINT_ANCHOR_MAX_ATTEMPTS=8
SCHEMA_GUARD_ALERT_WEBHOOK_POLL_INTERVAL_MS=5000
SCHEMA_GUARD_ALERT_WEBHOOK_REQUEST_TIMEOUT_MS=5000
SCHEMA_GUARD_ALERT_WEBHOOK_MAX_ATTEMPTS=8
