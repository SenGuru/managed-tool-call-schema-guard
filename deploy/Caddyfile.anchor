{
	admin off
	email {$SCHEMA_GUARD_ACME_EMAIL}
	http_port 8080
	https_port 8443
}

http://{$SCHEMA_GUARD_ANCHOR_HOST} {
	redir https://{host}{uri} permanent
}

{$SCHEMA_GUARD_ANCHOR_HOST} {
	request_body {
		max_size 64KB
	}
	header {
		-Server
		Cache-Control "no-store"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
	}
	reverse_proxy schema-guard-anchor-receiver:8790
}
