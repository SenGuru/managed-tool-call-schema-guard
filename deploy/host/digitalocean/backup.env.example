# Install as /etc/akriven/schema-guard-anchor/backup.env with mode 0600.
# This file contains secret *locations* only. Do not place key material here.
AKRIVEN_BACKUP_REMOTE_HOST=208.113.209.209
AKRIVEN_BACKUP_REMOTE_USER=akriven-backup-anchor
AKRIVEN_BACKUP_SSH_KEY=/etc/akriven/schema-guard-anchor/backup-ssh/id_ed25519
AKRIVEN_BACKUP_RECIPIENT_FILE=/etc/akriven/schema-guard-anchor/backup-age-recipients.txt
AKRIVEN_BACKUP_KNOWN_HOSTS=/etc/akriven/schema-guard-anchor/backup-ssh/known_hosts
AKRIVEN_BACKUP_REMOTE_DIRECTORY=incoming
AKRIVEN_BACKUP_LOCAL_DIRECTORY=/var/lib/akriven-backup-anchor
AKRIVEN_BACKUP_STATUS_FILE=/var/lib/akriven-backup-anchor/status.json
AKRIVEN_ANCHOR_CONTAINER=schema-guard-anchor-schema-guard-anchor-receiver-1
AKRIVEN_ANCHOR_VOLUME=schema-guard-anchor_schema-guard-anchor-data
AKRIVEN_BACKUP_UTILITY_IMAGE=akriven-backup-utility:busybox-1.37.0-musl-amd64
