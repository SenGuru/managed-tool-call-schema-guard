# Install as /etc/akriven/schema-guard-main/backup.env with mode 0600.
# This file contains secret *locations* only. Do not place key material here.
AKRIVEN_BACKUP_REMOTE_HOST=147.182.213.242
AKRIVEN_BACKUP_REMOTE_USER=akriven-backup-main
AKRIVEN_BACKUP_SSH_KEY=/etc/akriven/schema-guard-main/backup-ssh/id_ed25519
AKRIVEN_BACKUP_RECIPIENT_FILE=/etc/akriven/schema-guard-main/backup-age-recipients.txt
AKRIVEN_BACKUP_KNOWN_HOSTS=/etc/akriven/schema-guard-main/backup-ssh/known_hosts
AKRIVEN_BACKUP_REMOTE_DIRECTORY=incoming
AKRIVEN_BACKUP_LOCAL_DIRECTORY=/var/lib/akriven-backup-main
AKRIVEN_BACKUP_STATUS_FILE=/var/lib/akriven-backup-main/status.json
AKRIVEN_BACKUP_HEARTBEAT_URL_FILE=/etc/akriven/schema-guard-main/backup-heartbeat-url
AKRIVEN_POSTGRES_CONTAINER=schema-guard-main-schema-guard-postgres-1
AKRIVEN_MANAGED_CONTAINER=schema-guard-main-schema-guard-managed-1
