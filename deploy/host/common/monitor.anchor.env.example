# Install as /etc/akriven/monitor.env with mode 0600 on the anchor host.
# Store the external paging/heartbeat URL in AKRIVEN_MONITOR_WEBHOOK_FILE,
# never directly in this file.
AKRIVEN_MONITOR_NAME=anchor
AKRIVEN_MONITOR_URLS="http://127.0.0.1:8790/readyz https://api.akriven.com/readyz"
AKRIVEN_MONITOR_CONTAINERS="schema-guard-anchor-schema-guard-anchor-receiver-1 schema-guard-anchor-schema-guard-anchor-edge-1"
AKRIVEN_TLS_HOSTS="anchor.akriven.com:443 api.akriven.com:443"
AKRIVEN_BACKUP_STATUS_FILE=/var/lib/akriven-backup-anchor/status.json
AKRIVEN_MAX_BACKUP_AGE_SECONDS=93600
AKRIVEN_TLS_MIN_SECONDS=1209600
AKRIVEN_MONITOR_STATE_DIRECTORY=/var/lib/akriven-monitor
AKRIVEN_MONITOR_WEBHOOK_FILE=/etc/akriven/monitor-webhook-url
