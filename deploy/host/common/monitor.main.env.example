# Install as /etc/akriven/monitor.env with mode 0600 on the main host.
# Store the external paging/heartbeat URL in AKRIVEN_MONITOR_WEBHOOK_FILE,
# never directly in this file.
AKRIVEN_MONITOR_NAME=main
AKRIVEN_MONITOR_URLS="http://127.0.0.1:8788/readyz https://anchor.akriven.com/readyz"
AKRIVEN_MONITOR_CONTAINERS="schema-guard-main-schema-guard-managed-1 schema-guard-main-schema-guard-postgres-1 schema-guard-main-schema-guard-edge-1"
AKRIVEN_TLS_HOSTS="api.akriven.com:443 anchor.akriven.com:443"
AKRIVEN_BACKUP_STATUS_FILE=/var/lib/akriven-backup-main/status.json
AKRIVEN_MAX_BACKUP_AGE_SECONDS=93600
AKRIVEN_TLS_MIN_SECONDS=1209600
AKRIVEN_MONITOR_STATE_DIRECTORY=/var/lib/akriven-monitor
AKRIVEN_MONITOR_WEBHOOK_FILE=/etc/akriven/monitor-webhook-url
