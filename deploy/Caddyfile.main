{
	admin off
	email {$SCHEMA_GUARD_ACME_EMAIL}
	http_port 8080
	https_port 8443
}

http://{$SCHEMA_GUARD_APP_HOST} {
	redir https://{host}{uri} permanent
}

{$SCHEMA_GUARD_APP_HOST} {
	request_body {
		max_size 1MB
	}
	header {
		-Server
		Cache-Control "no-store"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
	}
	@root path /
	redir @root /dashboard 302
	reverse_proxy schema-guard-managed:8788
}
